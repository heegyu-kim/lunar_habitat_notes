# Godot 4+ specific ignores
.godot/

# Android build template
/android/

# keystore
export_credentials.cfg

# build
*.apk
/build/

*.tmp

# OS
.DS_Store
Thumbs.db
desktop.ini

# OpenXR Vendors plugin
/addons/godotopenxrvendors/
/asset/

# ffmpeg binary for clip recording (105 MB, too big for GitHub). See tools/README.txt
/tools/ffmpeg.exe
/tools/ffmpeg
ffmpeg-*.log

# The six habitat sounds in assets/audio/ are part of this branch (they are still left out of the
# other branches, where tools/prepare_habitat_audio.py prepares them from local copies).

# Blender working files converted from the glb models (tools/glb_to_blend_fbx.py)
/blender/

# Python caches and Godot import stubs under docs
__pycache__/
/docs/**/*.import
