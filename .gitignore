# Godot 4+ specific ignores
.godot/

# Android build template
/android/

# keystore
export_credentials.cfg

# build
*.apk
/build/

*.tmp

# OS
.DS_Store
Thumbs.db
desktop.ini

# OpenXR Vendors plugin
/addons/godotopenxrvendors/
/asset/

# ffmpeg binary for clip recording (105 MB, too big for GitHub). See tools/README.txt
/tools/ffmpeg.exe
/tools/ffmpeg
ffmpeg-*.log

# Local sound-library assets: prepare with tools/prepare_habitat_audio.py.
/assets/audio/*.wav
/assets/audio/*.wav.import

# Blender working files converted from the glb models (tools/glb_to_blend_fbx.py)
/blender/

# Python caches and Godot import stubs under docs
__pycache__/
/docs/**/*.import
